{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mythpen",
  "version": "0.0.10",
  "identifier": "com.mythpen.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:all",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Mythpen",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mythpen-server"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNUU3RERCODM4MDdGMQpSV1R4QnppNDNlY1ZEenE1dy9rd3M5SVBxMGJaWTBQUGhaL3BtaExMVVJXWFJ4cjU5ZjlmVDdjbAo=",
      "endpoints": [
        "https://github.com/niyongsheng/mythpen/releases/latest/download/latest.json"
      ]
    }
  }
}
